filters:
  and:
    - file.ext == "md"
    - tipo != "indice"
    - tipo != "guida"
    - not:
        - file.inFolder("modelli")
properties:
  file.name:
    displayName: Nota
  file.folder:
    displayName: Cartella
  tipo:
    displayName: Tipo
  corso:
    displayName: Corso
  data:
    displayName: Data
  semestre:
    displayName: Semestre
views:
  - type: table
    name: Tutte le note
    groupBy:
      property: corso
      direction: ASC
    order:
      - file.name
      - tipo
      - data
      - semestre
