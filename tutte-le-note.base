filters:
  and:
    - file.ext == "md"
    - 'tipo != "indice"'
    - 'tipo != "guida"'
    - not:
        - file.inFolder("modelli")

properties:
  file.name:
    displayName: Nota
  tipo:
    displayName: Tipo
  corso:
    displayName: Corso
  data:
    displayName: Data
  semestre:
    displayName: Semestre

views:
  - type: table
    name: Tutte le note
    groupBy:
      property: corso
      direction: ASC
    order:
      - file.name
      - tipo
      - data
      - semestre

  - type: table
    name: Lezioni
    filters:
      and:
        - 'tipo == "lezione"'
    groupBy:
      property: corso
      direction: ASC
    order:
      - file.name
      - data

  - type: table
    name: Appunti
    filters:
      and:
        - 'tipo == "appunti"'
    groupBy:
      property: corso
      direction: ASC
    order:
      - file.name
      - data

  - type: table
    name: Sintesi
    filters:
      and:
        - 'tipo == "sintesi"'
    groupBy:
      property: corso
      direction: ASC
    order:
      - file.name
      - data
